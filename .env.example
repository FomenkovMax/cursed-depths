# For local development: SQLite file
DATABASE_URL=file:../db/custom.db

# For production (Vercel): Turso cloud database
# DATABASE_URL=file:../db/custom.db  (used at build time only)
# TURSO_URL=libsql://your-db-name.turso.io  (used at runtime)
# DATABASE_AUTH_TOKEN=your-turso-auth-token

BOT_TOKEN=your-telegram-bot-token
WEBAPP_URL=https://your-domain.ru

# Bot's @username (without @) — used client-side to build party invite deep links
# (t.me/<username>?start=party_<id>), see src/components/game/PartyTab.tsx.
NEXT_PUBLIC_BOT_USERNAME=your_bot_username

# Secret required to call GET /api/telegram/setup
SETUP_SECRET=your-setup-secret

# Secret required to call POST /api/seed?secret=...
SEED_SECRET=your-seed-secret

# Secret for GET /api/cron/daily-reminder and GET /api/cron/backup-db (Vercel Cron, see "crons"
# in vercel.json — sends via Authorization: Bearer header automatically; ?secret=... also
# accepted for manual testing). Vercel Hobby plan crons fire at most once per day per job.
CRON_SECRET=your-cron-secret

# Telegram chat ID that receives weekly DB backups from GET /api/cron/backup-db (your own DM
# with the bot, or a private channel/group — get your numeric chat ID by messaging the bot and
# checking getUpdates, or use @userinfobot). Read-only dump of the whole DB, gzipped, sent as a
# document via the bot — no new paid backup service needed.
BACKUP_CHAT_ID=your-telegram-chat-id

# For local development: SQLite file
DATABASE_URL=file:./db/custom.db

# For production (Vercel): Turso cloud database
# DATABASE_URL=file:./db/custom.db  (used at build time only)
# TURSO_URL=libsql://your-db-name.turso.io  (used at runtime)
# DATABASE_AUTH_TOKEN=your-turso-auth-token

BOT_TOKEN=your-telegram-bot-token
WEBAPP_URL=https://your-domain.ru

# Secret required to call GET /api/telegram/setup
SETUP_SECRET=your-setup-secret

# Secret required to call POST /api/seed?secret=...
SEED_SECRET=your-seed-secret

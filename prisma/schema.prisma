generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Player {
  id              String    @id @default(cuid())
  telegramId      String    @unique
  name            String
  raceId          String
  race            Race      @relation(fields: [raceId], references: [id])
  classId         String
  class           GameClass @relation(fields: [classId], references: [id])
  level           Int       @default(1)
  xp              Int       @default(0)
  xpToNext        Int       @default(100)
  hp              Int       @default(10)
  maxHp           Int       @default(10)
  mp              Int       @default(100)
  maxMp           Int       @default(100)
  strength        Int       @default(10)
  dexterity       Int       @default(10)
  vitality        Int       @default(10)
  intellect       Int       @default(10)
  willpower       Int       @default(10)
  instinct        Int       @default(10)
  statPoints      Int       @default(0) // неизрасходованные очки характеристик
  gold            Int       @default(0)
  locationId      String    @default("town")
  inCombat        Boolean   @default(false)
  enemyId         String?
  enemyHp         Int?
  enemyMaxHp      Int?
  combatLog       String?   // JSON string
  bossState       String?   // JSON string — фазы/щит/ДоТ/призывы текущего боя с боссом (см. lib/boss-mechanics.ts)
  lastDailyReward String?   // ISO date string
  consumableAttackBonus  Int @default(0) // временный бонус к атаке от Эликсира Мощи (elixir_power)
  consumableFightsLeft   Int @default(0) // на сколько ещё боёв действует consumableAttackBonus
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  inventory       Inventory[]
  quests          PlayerQuest[]
  creation        CharacterCreation?
  partyMember     PartyMember?

  @@index([telegramId])
  @@index([locationId])
  @@index([level])
  @@index([raceId])
  @@index([classId])
}

// Пати (совместный бой) — см. lib/party-combat-engine.ts. Игрок состоит максимум в одной
// пати одновременно (PartyMember.playerId уникален). Приглашение — Telegram deep-link
// (t.me/bot?start=party_<id>), поэтому отдельной модели приглашений нет — вступление это
// просто POST /api/party/join, пока пати status='forming' и не заполнена.
model Party {
  id        String   @id @default(cuid())
  leaderId  String   // Player.id лидера пати
  status    String   @default("forming") // forming | in_combat | disbanded
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   PartyMember[]
  combat    PartyCombat?
}

model PartyMember {
  id       String   @id @default(cuid())
  partyId  String
  party    Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  playerId String   @unique
  player   Player   @relation(fields: [playerId], references: [id])
  joinedAt DateTime @default(now())

  @@index([partyId])
}

// Совместный бой пати — параллельная система combat-состояния, НЕ трогает Player.inCombat/
// enemyId/enemyHp/bossState/combatLog (те остаются только для одиночного боя). ХП каждого
// участника хранится в его собственной строке Player (см. lib/party-combat-engine.ts) — здесь
// только оркестрация ходов и эффектов, без дублирования здоровья.
model PartyCombat {
  id         String   @id @default(cuid())
  partyId    String   @unique
  party      Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  enemyId    String
  enemyHp    Int
  enemyMaxHp Int
  state      String   // JSON string — PartyFightState, см. lib/party-combat-engine.ts
  status     String   @default("active") // active | won | lost
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Inventory {
  id         String  @id @default(cuid())
  playerId   String
  player     Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  itemId     String
  name       String
  type       String  // weapon, armor, accessory, consumable, material, quest
  rarity     String  // common, uncommon, rare, epic, legendary, artifact, mythic
  equipped   Boolean @default(false)
  slot       String? // weapon, head, chest, legs, feet, accessory1, accessory2
  stats      String? // JSON string with bonuses
  quantity   Int     @default(1)
  icon       String? // emoji or image path

  @@index([playerId])
  @@index([itemId])
}

model CharacterCreation {
  id        String  @id @default(cuid())
  playerId  String  @unique
  player    Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  step      Int     @default(0) // 0=name, 1=race, 2=class, 3=confirm
  name      String?
  race      String?
  class     String?
}

model PlayerQuest {
  id          String   @id @default(cuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  questId     String
  type        String   // daily, kill, explore, craft
  title       String
  description String
  target      Int      // e.g. kill 5 goblins
  progress    Int      @default(0)
  completed   Boolean  @default(false)
  claimed     Boolean  @default(false)
  reward      String   // JSON: {xp, gold, items}
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([playerId])
  @@index([completed])
}

model Enemy {
  id          String  @id @default(cuid())
  nameRu      String
  nameEn      String
  hp          Int
  ac          Int
  attack      Int
  damage      String  // e.g. "1d6+2"
  xp          Int
  gold        Int
  lootTable   String? // JSON array of {itemId, chance}
  locationId  String
  isBoss      Boolean @default(false)
  icon        String? // emoji

  @@index([locationId])
}

// Расы, классы и способности — источник истины: docs/cursed_depths_master.pdf
// и docs/cursed_depths_abilities.pdf (v2 — баланс). 6 рас, 26 классов (по 4 на
// расу, кроме Людей — у них 6: по 3 на каждый Путь), ~180 способностей по 3
// стадиям эволюции на класс.
model Race {
  id            String  @id @default(cuid())
  name          String
  slug          String  @unique
  description   String
  icon          String
  lore          String  // связь расы со Столпом-богом (Библия мира)
  baseStrength  Int
  baseDexterity Int
  baseVitality  Int
  baseIntellect Int
  baseWillpower Int
  baseInstinct  Int

  classes       GameClass[]
  players       Player[]
}

model GameClass {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  icon        String
  raceId      String
  race        Race      @relation(fields: [raceId], references: [id], onDelete: Cascade)
  path        String    // ash (Путь Пепла) | blight (Путь Скверны)
  role        String    // tank, healer, dps, support, antibuff
  primaryStat String    // приоритетная характеристика (информационно)

  abilities   Ability[]
  players     Player[]

  @@index([raceId])
  @@index([path])
}

model Ability {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  icon        String
  classId     String
  class       GameClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  stage       Int       // 1, 2 или 3 — стадия эволюции класса
  stageName   String    // название тира на этой стадии (напр. "Страж Предела")
  type        String    // active | passive
  bossNote    String?   // как способность работает иначе против боссов

  @@index([classId])
  @@index([stage])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Player {
  id              String    @id @default(cuid())
  telegramId      String    @unique
  name            String
  raceId          String
  race            Race      @relation(fields: [raceId], references: [id])
  classId         String
  class           GameClass @relation(fields: [classId], references: [id])
  level           Int       @default(1)
  xp              Int       @default(0)
  xpToNext        Int       @default(100)
  hp              Int       @default(10)
  maxHp           Int       @default(10)
  mp              Int       @default(100)
  maxMp           Int       @default(100)
  strength        Int       @default(10)
  dexterity       Int       @default(10)
  vitality        Int       @default(10)
  intellect       Int       @default(10)
  willpower       Int       @default(10)
  instinct        Int       @default(10)
  statPoints      Int       @default(0) // неизрасходованные очки характеристик
  gold            Int       @default(0)
  locationId      String    @default("town")
  inCombat        Boolean   @default(false)
  enemyId         String?
  enemyHp         Int?
  enemyMaxHp      Int?
  combatLog       String?   // JSON string
  bossState       String?   // JSON string — фазы/щит/ДоТ/призывы текущего боя с боссом (см. lib/boss-mechanics.ts)
  lastDailyReward String?   // ISO date string
  consumableAttackBonus  Int @default(0) // временный бонус к атаке от Эликсира Мощи (elixir_power)
  consumableFightsLeft   Int @default(0) // на сколько ещё боёв действует consumableAttackBonus
  totalKills      Int       @default(0) // счётчики за всё время — база для ачивок (achievements.ts)
  totalExplores   Int       @default(0)
  totalCrafts     Int       @default(0)
  partyWins       Int       @default(0)
  dungeonId       String?   // текущий забег по данжу (lib/dungeons.ts) — null, если не в данже
  dungeonRoom     Int       @default(0) // 0-based индекс текущей комнаты забега
  dungeonModifierId String? // модификатор этого забега (lib/dungeon-modifiers.ts) — null, если
                            // забега нет или выпал "чистый" забег без модификатора
  abyssDepth      Int       @default(0) // текущая глубина активного забега по Бездонному Разлому
                            // (lib/abyss.ts) — 0, если не в Разломе
  bestAbyssDepth  Int       @default(0) // рекорд глубины — никогда не уменьшается, даже после
                            // смерти/побега (в отличие от abyssDepth, который сбрасывается)
  pvpRating       Int       @default(1000) // Elo-рейтинг PvP-арены (lib/pvp.ts) — реальные HP/MP
                            // при поражении НЕ трогаются, это асинхронный "призрачный бой"
  pvpWins         Int       @default(0)
  pvpLosses       Int       @default(0)
  worldBossAttacksToday Int @default(0) // сбрасывается лениво при первой атаке нового дня
  worldBossAttackDate   String? // "YYYY-MM-DD" последней атаки — тот же паттерн, что lastDailyReward
  fortressAssaultsToday Int @default(0) // штурмы Крепости (lib/fortress.ts) — тот же паттерн
  fortressAssaultDate   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  inventory       Inventory[]
  quests          PlayerQuest[]
  creation        CharacterCreation?
  partyMember     PartyMember?
  achievements    PlayerAchievement[]
  codexEntries    PlayerCodexEntry[]
  recipes         PlayerRecipe[]
  guildMember     GuildMember?
  seasonRewards   SeasonReward[]
  marketListings  MarketListing[]
  worldBossHits   WorldBossContribution[]
  stashItems      StashItem[]
  fortressAssaults FortressContribution[]

  @@index([telegramId])
  @@index([locationId])
  @@index([level])
  @@index([raceId])
  @@index([classId])
}

// Пати (совместный бой) — см. lib/party-combat-engine.ts. Игрок состоит максимум в одной
// пати одновременно (PartyMember.playerId уникален). Приглашение — Telegram deep-link
// (t.me/bot?start=party_<id>), поэтому отдельной модели приглашений нет — вступление это
// просто POST /api/party/join, пока пати status='forming' и не заполнена.
model Party {
  id        String   @id @default(cuid())
  leaderId  String   // Player.id лидера пати
  status    String   @default("forming") // forming | in_combat | disbanded
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   PartyMember[]
  combat    PartyCombat?
}

model PartyMember {
  id       String   @id @default(cuid())
  partyId  String
  party    Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  playerId String   @unique
  player   Player   @relation(fields: [playerId], references: [id])
  joinedAt DateTime @default(now())

  @@index([partyId])
}

// Совместный бой пати — параллельная система combat-состояния, НЕ трогает Player.inCombat/
// enemyId/enemyHp/bossState/combatLog (те остаются только для одиночного боя). ХП каждого
// участника хранится в его собственной строке Player (см. lib/party-combat-engine.ts) — здесь
// только оркестрация ходов и эффектов, без дублирования здоровья.
model PartyCombat {
  id         String   @id @default(cuid())
  partyId    String   @unique
  party      Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  enemyId    String
  enemyHp    Int
  enemyMaxHp Int
  state      String   // JSON string — PartyFightState, см. lib/party-combat-engine.ts
  status     String   @default("active") // active | won | lost
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Гильдия — постоянная социальная группа (в отличие от Party, которая существует только на
// время одного совместного боя). Приглашение — тот же Telegram deep-link паттерн, что и у
// пати (t.me/bot?start=guild_<id>), см. webhook/route.ts.
model Guild {
  id        String   @id @default(cuid())
  name      String   @unique
  tag       String   // короткий тег 2-6 символов, показывается рядом с именем игрока
  leaderId  String   // Player.id
  createdAt DateTime @default(now())

  members   GuildMember[]
  fortressAssaults FortressContribution[]
}

model GuildMember {
  id       String   @id @default(cuid())
  guildId  String
  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  playerId String   @unique // игрок состоит максимум в одной гильдии одновременно
  player   Player   @relation(fields: [playerId], references: [id])
  joinedAt DateTime @default(now())

  @@index([guildId])
}

// Аукцион игрок-игроку — POE2-style trade, но без отдельного "сайта": предмет при выставлении
// удаляется из Inventory продавца и его данные копируются сюда (эскроу) — гарантирует, что
// выставленный предмет нельзя случайно надеть/скрафтить/использовать, пока он на аукционе.
// При покупке/отмене строка удаляется, а предмет пересоздаётся в Inventory покупателя/
// обратно продавца. Комиссия 10% при продаже — не откладывается никуда, чистый sink золота
// (экономика уже получила несколько новых источников голда за эту сессию — крафт-валюта,
// заточка, модификаторы данжей, Разлом — нужен противовес).
model MarketListing {
  id               String   @id @default(cuid())
  sellerId         String
  seller           Player   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  itemId           String
  name             String
  type             String
  rarity           String
  stats            String?
  icon             String?
  itemLevel        Int?
  affixTier        String?
  affixes          String?
  enhancementLevel Int      @default(0)
  quantity         Int      @default(1)
  price            Int
  createdAt        DateTime @default(now())

  @@index([sellerId])
}

// Мировой босс — единственная строка-синглтон (id всегда "current"), общая HP для ВСЕХ игроков
// разом. Атака лениво роллится в POST /api/worldboss/attack (lib/world-boss.ts) — при 0 HP тут
// же выдаёт награду всем участникам текущего incarnation пропорционально их урону и спавнит
// следующего (incarnation+1, maxHp немного выше). Игрок не получает урон в ответ — это разовый
// вклад в общую цель, а не полноценный бой (аналог "мировых боссов" в мобильных RPG).
model WorldBoss {
  id          String   @id
  incarnation Int      @default(1)
  name        String
  hp          Int
  maxHp       Int
  spawnedAt   DateTime @default(now())

  contributions WorldBossContribution[]
}

// Один удар одного игрока по текущему incarnation мирового босса — сумма по playerId даёт долю
// награды при убийстве. Строки за ПРОШЛЫЕ incarnation удаляются сразу после раздачи наград
// (см. lib/world-boss.ts) — это эфемерный игровой прогресс, не история для отображения.
model WorldBossContribution {
  id          String    @id @default(cuid())
  bossId      String
  boss        WorldBoss @relation(fields: [bossId], references: [id], onDelete: Cascade)
  incarnation Int
  playerId    String
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  damage      Int
  createdAt   DateTime  @default(now())

  @@index([bossId, incarnation])
  @@index([playerId])
}

// Хранилище (сундук) — отдельное от боевого Inventory место для коллекционирования, не
// занимает боевые слоты и не расходуется/не экипируется напрямую (сначала нужно "достать"
// обратно в Inventory через POST /api/stash/retrieve). Ограничено STASH_CAPACITY
// (lib/stash.ts) — не безлимитный склад, а осмысленный выбор, что стоит сохранить.
model StashItem {
  id               String  @id @default(cuid())
  playerId         String
  player           Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  itemId           String
  name             String
  type             String
  rarity           String
  stats            String?
  icon             String?
  itemLevel        Int?
  affixTier        String?
  affixes          String?
  enhancementLevel Int     @default(0)
  quantity         Int     @default(1)

  @@index([playerId])
}

// Крепость — единственный синглтон-объект territory-control между ГИЛЬДИЯМИ (в отличие от
// WorldBoss, который общий для всех игроков разом, здесь соревнуются гильдии между собой).
// Недельный цикл (ISO-неделя, lib/fortress.ts currentWeekId) — гильдия с наибольшей суммой
// очков штурма за цикл коронуется контролирующей и её участники получают +10% золота с любого
// боя до конца следующего цикла (см. combat/action.ts). Если за цикл никто не штурмовал —
// контроль остаётся у прежнего владельца (некому оспорить).
model Fortress {
  id                 String  @id
  cycleId            String  // "YYYY-Www"
  controllingGuildId String?

  contributions FortressContribution[]
}

// Один штурм одного игрока в текущем цикле — сумма по guildId даёт итог для коронации в конце
// цикла. Строки за ПРОШЛЫЙ цикл удаляются сразу после коронации (см. lib/fortress.ts) — как и
// WorldBossContribution, это эфемерный прогресс, не история.
model FortressContribution {
  id         String   @id @default(cuid())
  fortressId String
  fortress   Fortress @relation(fields: [fortressId], references: [id], onDelete: Cascade)
  cycleId    String
  guildId    String
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  points     Int
  createdAt  DateTime @default(now())

  @@index([cycleId, guildId])
  @@index([playerId])
}

// Разблокированные ачивки — определения статичны в lib/achievements.ts, здесь только факт
// разблокировки конкретным игроком (проверяется лениво на GET /api/achievements).
model PlayerAchievement {
  id            String   @id @default(cuid())
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  achievementId String
  unlockedAt    DateTime @default(now())

  @@unique([playerId, achievementId])
  @@index([playerId])
}

// Разблокированные записи лор-кодекса — определения статичны в lib/codex.ts, здесь только
// факт разблокировки (проверяется лениво на GET /api/codex, тот же паттерн, что и ачивки).
model PlayerCodexEntry {
  id         String   @id @default(cuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  entryId    String
  unlockedAt DateTime @default(now())

  @@unique([playerId, entryId])
  @@index([playerId])
}

// Постоянно изученные рецепты тира 3 — изучаются один раз через POST /api/craft/learn,
// расходуя предмет-чертёж (см. ITEMS type: 'blueprint' в game-data.ts). recipeId — id из
// CRAFTING_RECIPES (game-data.ts), не строка из БД — рецепты статичны, как и всё остальное
// игровое содержимое.
model PlayerRecipe {
  id         String   @id @default(cuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  recipeId   String
  unlockedAt DateTime @default(now())

  @@unique([playerId, recipeId])
  @@index([playerId])
}

// Награды за топ-3 места сезонного лидерборда — раздаются лениво раз в месяц, см.
// lib/seasons.ts и GET /api/leaderboard. Один ряд = одна выданная награда одному игроку
// за конкретный сезон ("2026-07"), список за сезон — история для "🏆 Прошлый сезон" в UI.
model SeasonReward {
  id         String   @id @default(cuid())
  season     String
  rank       Int
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  rewardGold Int
  rewardXp   Int
  awardedAt  DateTime @default(now())

  @@unique([season, rank])
  @@index([season])
}

model Inventory {
  id         String  @id @default(cuid())
  playerId   String
  player     Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  itemId     String
  name       String
  type       String  // weapon, armor, accessory, consumable, material, quest
  rarity     String  // common, uncommon, rare, epic, legendary, artifact, mythic
  equipped   Boolean @default(false)
  slot       String? // weapon, head, chest, legs, feet, accessory1, accessory2
  stats      String? // JSON string with bonuses
  quantity   Int     @default(1)
  icon       String? // emoji or image path
  itemLevel  Int?    // уровень предмета в момент выпадения — определяет доступные тиры аффиксов
                      // (см. lib/item-affixes.ts). null у предметов, не проходивших через ролл
                      // (материалы, куплен в магазине, скрафчен, квестовая награда).
  affixTier  String? // normal | magic | rare | corrupted — независимая от `rarity` ось: сколько
                      // случайных аффиксов накатано на этот конкретный экземпляр снаряжения.
                      // `rarity` остаётся как есть — это базовая ценность шаблона предмета.
  affixes    String? // JSON RolledAffix[] — какие именно аффиксы накатаны, для отображения и
                      // для крафт-валют (lib/item-affixes.ts, POST /api/craft/currency).
  enhancementLevel Int @default(0) // "заточка" 0-10 — см. lib/item-enhancement.ts. Каждый
                      // успешный уровень прибавляет +1 к каждому числовому ключу в `stats`
                      // (уже включён в сумму `stats`, как и аффиксы).

  @@index([playerId])
  @@index([itemId])
}

model CharacterCreation {
  id        String  @id @default(cuid())
  playerId  String  @unique
  player    Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  step      Int     @default(0) // 0=name, 1=race, 2=class, 3=confirm
  name      String?
  race      String?
  class     String?
}

model PlayerQuest {
  id          String   @id @default(cuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  questId     String
  type        String   // daily, kill, explore, craft
  title       String
  description String
  target      Int      // e.g. kill 5 goblins
  progress    Int      @default(0)
  completed   Boolean  @default(false)
  claimed     Boolean  @default(false)
  reward      String   // JSON: {xp, gold, items}
  createdAt   DateTime @default(now())

  @@index([playerId])
  @@index([completed])
}

model Enemy {
  id          String  @id @default(cuid())
  nameRu      String
  nameEn      String
  hp          Int
  ac          Int
  attack      Int
  damage      String  // e.g. "1d6+2"
  xp          Int
  gold        Int
  lootTable   String? // JSON array of {itemId, chance}
  locationId  String
  isBoss      Boolean @default(false)
  icon        String? // emoji

  @@index([locationId])
}

// Расы, классы и способности — источник истины: docs/cursed_depths_master.pdf
// и docs/cursed_depths_abilities.pdf (v2 — баланс). 6 рас, 26 классов (по 4 на
// расу, кроме Людей — у них 6: по 3 на каждый Путь), ~180 способностей по 3
// стадиям эволюции на класс.
model Race {
  id            String  @id @default(cuid())
  name          String
  slug          String  @unique
  description   String
  icon          String
  lore          String  // связь расы со Столпом-богом (Библия мира)
  baseStrength  Int
  baseDexterity Int
  baseVitality  Int
  baseIntellect Int
  baseWillpower Int
  baseInstinct  Int

  classes       GameClass[]
  players       Player[]
}

model GameClass {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  icon        String
  raceId      String
  race        Race      @relation(fields: [raceId], references: [id], onDelete: Cascade)
  path        String    // ash (Путь Пепла) | blight (Путь Скверны)
  role        String    // tank, healer, dps, support, antibuff
  primaryStat String    // приоритетная характеристика (информационно)

  abilities   Ability[]
  players     Player[]

  @@index([raceId])
  @@index([path])
}

model Ability {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  icon        String
  classId     String
  class       GameClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  stage       Int       // 1, 2 или 3 — стадия эволюции класса
  stageName   String    // название тира на этой стадии (напр. "Страж Предела")
  type        String    // active | passive
  bossNote    String?   // как способность работает иначе против боссов

  @@index([classId])
  @@index([stage])
}

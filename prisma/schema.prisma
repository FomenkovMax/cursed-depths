generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Player {
  id              String    @id @default(cuid())
  telegramId      String    @unique // "активный" ключ авторизации — см. accountId ниже
  accountId       String?   // группирует до 2 персонажей-слотов одного Telegram-аккаунта (аудит
                             // 4.1, D1/D3). Значение — РЕАЛЬНЫЙ telegramId владельца, общий у
                             // обоих слотов; null у обычных (однослотовых) аккаунтов. НЕ участвует
                             // в авторизации напрямую — только группировка для переключения слотов
                             // (lib/social/account-slots.ts). Единственное поле, которое реально
                             // меняется при переключении — telegramId выше: неактивный слот хранит
                             // в telegramId детерминированный placeholder `${accountId}__slot${N}`
                             // (см. slotNumber), активный — настоящий telegramId. Благодаря этому
                             // остальные 80+ роутов, ищущие игрока по telegramId из заголовка
                             // авторизации, продолжают работать БЕЗ единого изменения — они всегда
                             // находят ровно того персонажа, что сейчас активен.
  slotNumber      Int       @default(1) // 1 = первый (обычный) слот, 2 = второй. Стабильный номер,
                             // не меняется при переключении — нужен, чтобы детерминированно
                             // восстановить placeholder telegramId при уходе слота в неактив.
  name            String
  raceId          String
  race            Race      @relation(fields: [raceId], references: [id])
  classId         String
  class           GameClass @relation(fields: [classId], references: [id])
  level           Int       @default(1)
  xp              Int       @default(0)
  xpToNext        Int       @default(100)
  hp              Int       @default(10)
  maxHp           Int       @default(10)
  mp              Int       @default(100)
  maxMp           Int       @default(100)
  strength        Int       @default(10)
  dexterity       Int       @default(10)
  vitality        Int       @default(10)
  intellect       Int       @default(10)
  willpower       Int       @default(10)
  instinct        Int       @default(10)
  statPoints      Int       @default(0) // неизрасходованные очки характеристик
  respecAvailable Boolean   @default(true) // разовый бесплатный respec (lib/respec.ts) ещё не использован
  gold            Int       @default(0)
  locationId      String    @default("town")
  inCombat        Boolean   @default(false)
  enemyId         String?
  enemyHp         Int?
  enemyMaxHp      Int?
  combatLog       String?   // JSON string
  bossState       String?   // JSON string — фазы/щит/ДоТ/призывы текущего боя с боссом (см. lib/boss-mechanics.ts)
  lastDailyReward String?   // ISO date string
  dailyStreak     Int       @default(0) // сколько дней подряд забирал ежедневную награду —
                            // растёт при заходе на следующий день после lastDailyReward,
                            // обнуляется в 1 при пропуске (см. lib/economy/daily-streak.ts).
                            // Классический day1..7 retention-хук, которого раньше не было вовсе.
  streakFreezeCount Int     @default(0) // заморозки стрика (MAX_STREAK_FREEZES в daily-streak.ts) —
                            // зарабатываются автоматически за каждый завершённый 7-дневный цикл
                            // (не покупаются, никакого ценового SKU), тратятся автоматически на
                            // РОВНО один пропущенный день клейма (см. shouldConsumeStreakFreeze) —
                            // без них любимая механика самых лояльных игроков ломалась от одного
                            // пропуска без права на ошибку.
  lastActionAt    DateTime? // время последнего "тяжёлого" действия (explore/combat action) —
                            // серверный guard минимального интервала против скриптового фарма,
                            // см. lib/economy/rate-limit.ts. НЕ полноценный rate limiter (для
                            // него нужна внешняя стораджа вроде Upstash Redis — сознательно не
                            // тянем, тот же принцип, что и "нет WebSocket/платных realtime" у
                            // party-combat-engine.ts), а простой минимальный интервал между
                            // запросами к одному игроку.
  consumableAttackBonus  Int @default(0) // временный бонус к атаке от Эликсира Мощи (elixir_power)
  consumableFightsLeft   Int @default(0) // на сколько ещё боёв действует consumableAttackBonus
  totalKills      Int       @default(0) // счётчики за всё время — база для ачивок (achievements.ts)
  totalExplores   Int       @default(0)
  totalCrafts     Int       @default(0)
  partyWins       Int       @default(0)
  dungeonId       String?   // текущий забег по данжу (lib/dungeons.ts) — null, если не в данже
  dungeonRoom     Int       @default(0) // 0-based индекс текущей комнаты забега
  dungeonModifierId String? // модификатор этого забега (lib/dungeon-modifiers.ts) — null, если
                            // забега нет или выпал "чистый" забег без модификатора
  dungeonHeatLevel Int      @default(0) // heat-уровень 0-5, ВЫБРАННЫЙ игроком перед входом в данж
                            // (lib/dungeon-modifiers.ts) — в отличие от dungeonModifierId выше,
                            // не случайный, действует поверх него
  enemyIsElite    Boolean   @default(false) // текущий враг — элитный ролл (5% шанс, только для
                            // обычных врагов вне данжей, см. api/explore/route.ts): x2 HP уже
                            // заложен в enemyHp при спавне, x3 loot читается отсюда при резолве
                            // боя (api/combat/action/route.ts). Сбрасывается на false при спавне
                            // любого другого врага (данж/испытание/Разлом), тот же паттерн, что и
                            // dungeonModifierId — состояние одного боевого раунда, не отдельная фича.
  abyssDepth      Int       @default(0) // текущая глубина активного забега по Бездонному Разлому
                            // (lib/abyss.ts) — 0, если не в Разломе
  bestAbyssDepth  Int       @default(0) // рекорд глубины — никогда не уменьшается, даже после
                            // смерти/побега (в отличие от abyssDepth, который сбрасывается)
  pvpRating       Int       @default(1000) // Elo-рейтинг PvP-арены (lib/pvp.ts) — реальные HP/MP
                            // при поражении НЕ трогаются, это асинхронный "призрачный бой"
  pvpWins         Int       @default(0)
  pvpLosses       Int       @default(0)
  leagueBonusScore Int      @default(0) // очки лиги за PvE-активность в ТЕКУЩЕМ сезоне (данжи,
                            // испытания, экспедиции — lib/social/pvp-season.ts LEAGUE_POINTS),
                            // складывается с pvpRating для итогового ранжирования топ-N в конце
                            // сезона (matchmaking по-прежнему использует чистый pvpRating —
                            // очки лиги влияют только на сезонную таблицу). Обнуляется при
                            // переходе сезона вместе с softReset рейтинга.
  lastReminderSentDate  String? // "YYYY-MM-DD" последней даты, когда GET /api/cron/daily-reminder
                            // отправил push-напоминание — не даёт cron'у слать дубликаты, если
                            // сработает дважды за день (тот же паттерн, что lastDailyReward ниже).
  worldBossAttacksToday Int @default(0) // сбрасывается лениво при первой атаке нового дня
  worldBossAttackDate   String? // "YYYY-MM-DD" последней атаки — тот же паттерн, что lastDailyReward
  fortressAssaultsToday Int @default(0) // штурмы Крепости (lib/fortress.ts) — тот же паттерн
  fortressAssaultDate   String?
  raidBossAttacksToday  Int @default(0) // атаки гильд-рейд-босса (lib/guild-raid-boss.ts) — тот же паттерн
  raidBossAttackDate    String?
  battlePassXp       Int    @default(0) // очки Боевого пропуска за ТЕКУЩИЙ сезон (lib/battle-pass.ts)
                             // — растут только пока премиум активен (полный лок, как у Комнаты
                             // трофеев), лениво сбрасываются в 0 при смене currentSeasonId()
  battlePassSeasonId String? // "YYYY-MM" сезона, за который считается battlePassXp — сравнивается
                             // с currentSeasonId() (lib/seasons.ts) при каждом начислении/чтении
  crownShards     Int       @default(0) // премиум-валюта "Осколки Короны" (lib/premium-shop.ts) —
                            // покупается за Telegram Stars, тратится на PREMIUM_CATALOG
  premiumUntil    DateTime? // до какого момента активен премиум-статус — null/в прошлом = нет
  stashCapacityBonus Int    @default(0) // разовое расширение хранилища сверх STASH_CAPACITY
                            // (покупка за Осколки Короны), накопительное
  deathDebuffUntil DateTime? // -15% опыта до этого момента (см. lib/premium-shop.ts
                            // isDeathDebuffActive) — ставится при каждой смерти, премиум
                            // полностью иммунен (проверяется вместе с этим полем, не отдельным флагом)
  fortuneSpinsToday Int     @default(0) // сколько раз колесо фортуны (lib/fortune-wheel.ts)
                            // крутили сегодня — тот же паттерн lazy-reset, что worldBossAttacksToday
  fortuneSpinDate   String? // "YYYY-MM-DD" последнего вращения
  activePetId       String? // id питомца из lib/pets.ts PET_CATALOG (не PlayerPet.id) — null,
                             // если ни один не активен. Активный питомец обязан быть среди
                             // pets ниже (проверяется в api/pets/activate), но хранится как
                             // плоский id для той же простоты, что и dungeonModifierId.
  activeTitleId     String? // id титула из lib/titles.ts TITLE_CATALOG — null, если не выбран.
                             // Премиум-эксклюзив целиком (не только отображение) — "разблокирован"
                             // считается лениво по текущей статистике игрока (lib/titles.ts
                             // isTitleUnlocked), без отдельной таблицы владения: чисто витринная
                             // механика без бонусов к статам, поэтому не нужно нигде, кроме шапки/
                             // топа/списка гильдии, где titleId резолвится в статический каталог.
  expeditionTierId  String? // id тира из lib/expeditions.ts EXPEDITION_TIERS — null, если герой
                             // никуда не отправлен. Экспедиция не блокирует обычную игру (можно
                             // продолжать драться/исследовать параллельно) — это чисто офлайн-
                             // таймер. Раньше был чисто премиум-эксклюзивным; с волны 2B (п.24)
                             // F2P тоже может отправить героя в самый короткий тир, см. поле ниже.
  expeditionEndsAt DateTime? // когда можно будет забрать награду — null, если экспедиции нет
  expeditionFreeUsedDate String? // "YYYY-MM-DD" последнего дня, когда F2P-игрок (без активного
                             // премиума) уже отправлял бесплатную короткую экспедицию — тот же
                             // lazy-reset паттерн, что и у worldBossAttackDate/fortuneSpinDate.
                             // Премиума не касается вовсе — у него нет дневного лимита тиров.
  bountyEnemyId   String?   // id босса-цели из ENEMIES на сегодня (lib/bounty-board.ts) — null,
                             // пока не назначен/не премиум
  bountyDate      String?   // "YYYY-MM-DD" дня, на который назначена цель — тот же lazy-reset
                             // паттерн, что и у lastDailyReward/worldBossAttackDate
  bountyAttempted Boolean   @default(false) // попытка охоты на сегодняшнюю цель уже потрачена
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  inventory       Inventory[]
  quests          PlayerQuest[]
  creation        CharacterCreation?
  partyMember     PartyMember?
  achievements    PlayerAchievement[]
  codexEntries    PlayerCodexEntry[]
  recipes         PlayerRecipe[]
  guildMember     GuildMember?
  seasonRewards   SeasonReward[]
  pvpSeasonRewards PvpSeasonReward[]
  marketListings  MarketListing[]
  auctionsSelling Auction[] @relation("AuctionSeller")
  auctionsBidding Auction[] @relation("AuctionBidder")
  worldBossHits   WorldBossContribution[]
  stashItems      StashItem[]
  fortressAssaults FortressContribution[]
  starPurchases   StarPurchase[]
  pets            PlayerPet[]
  guildRaidHits   GuildRaidContribution[]
  battlePassClaims PlayerBattlePassClaim[]
  visitedLocations VisitedLocation[]
  bossTrophies    PlayerBossTrophy[]
  weeklyChallengeResults WeeklyChallengeResult[]
  dailyLimits     PlayerDailyLimits?

  @@index([telegramId])
  @@index([accountId])
  @@index([locationId])
  @@index([level])
  @@index([raceId])
  @@index([classId])
}

// Журнал платежей Telegram Stars (lib/premium-shop.ts) — telegramChargeId уникален и служит
// ключом идемпотентности: Telegram может повторно прислать successful_payment при сетевых
// проблемах на своей стороне, и без этой записи повторная доставка задвоила бы начисление
// Осколков Короны. Строка создаётся ТОЛЬКО в момент реального начисления (см.
// /api/telegram/webhook), не в момент создания инвойса — invoice может быть создан и так и не
// оплачен.
model StarPurchase {
  id               String   @id @default(cuid())
  playerId         String
  player           Player   @relation(fields: [playerId], references: [id])
  packId           String   // какой SHARD_PACKS.id был куплен
  starsAmount      Int      // сколько Stars реально заплачено (для сверки/возвратов)
  shardsGranted    Int      // сколько Осколков Короны начислено (с учётом бонуса пака)
  telegramChargeId String   @unique
  createdAt        DateTime @default(now())

  @@index([playerId])
}

// Коллекция питомцев-компаньонов (lib/pets.ts PET_CATALOG) — каталог статичен в коде, как
// ITEMS/SHARD_PACKS, эта таблица только фиксирует ВЛАДЕНИЕ (кто что купил за Осколки Короны).
// Активный питомец (даёт пассивный бонус в бою) — Player.activePetId, отдельно от владения,
// т.к. игрок коллекционирует много питомцев, но активен всегда только один.
model PlayerPet {
  id         String   @id @default(cuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  petId      String   // id из PET_CATALOG
  obtainedAt DateTime @default(now())

  @@unique([playerId, petId])
  @@index([playerId])
}

// Пати (совместный бой) — см. lib/party-combat-engine.ts. Игрок состоит максимум в одной
// пати одновременно (PartyMember.playerId уникален). Приглашение — Telegram deep-link
// (t.me/bot?start=party_<id>), поэтому отдельной модели приглашений нет — вступление это
// просто POST /api/party/join, пока пати status='forming' и не заполнена.
model Party {
  id        String   @id @default(cuid())
  leaderId  String   // Player.id лидера пати
  status    String   @default("forming") // forming | in_combat | disbanded
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   PartyMember[]
  combat    PartyCombat?
}

model PartyMember {
  id       String   @id @default(cuid())
  partyId  String
  party    Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  playerId String   @unique
  player   Player   @relation(fields: [playerId], references: [id])
  joinedAt DateTime @default(now())

  @@index([partyId])
}

// Совместный бой пати — параллельная система combat-состояния, НЕ трогает Player.inCombat/
// enemyId/enemyHp/bossState/combatLog (те остаются только для одиночного боя). ХП каждого
// участника хранится в его собственной строке Player (см. lib/party-combat-engine.ts) — здесь
// только оркестрация ходов и эффектов, без дублирования здоровья.
model PartyCombat {
  id         String   @id @default(cuid())
  partyId    String   @unique
  party      Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  enemyId    String
  enemyHp    Int
  enemyMaxHp Int
  state      String   // JSON string — PartyFightState, см. lib/party-combat-engine.ts
  status     String   @default("active") // active | won | lost
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Гильдия — постоянная социальная группа (в отличие от Party, которая существует только на
// время одного совместного боя). Приглашение — тот же Telegram deep-link паттерн, что и у
// пати (t.me/bot?start=guild_<id>), см. webhook/route.ts.
model Guild {
  id        String   @id @default(cuid())
  name      String   @unique
  tag       String   // короткий тег 2-6 символов, показывается рядом с именем игрока
  leaderId  String   // Player.id
  createdAt DateTime @default(now())
  // Казна гильдии (аудит 4.1, D2) — накапливается пожертвованиями золота от участников
  // (POST /api/guild/donate), тратится лидером на разблокировку узлов дерева построек
  // (POST /api/guild/upgrade, см. lib/guild-upgrades.ts). Отдельный голд-синк, не связан
  // с личным золотом игрока после пожертвования.
  treasury  Int      @default(0)

  members   GuildMember[]
  fortressAssaults FortressContribution[]
  raidBoss  GuildRaidBoss?
  upgrades  GuildUpgrade[]
}

model GuildMember {
  id       String   @id @default(cuid())
  guildId  String
  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  playerId String   @unique // игрок состоит максимум в одной гильдии одновременно
  player   Player   @relation(fields: [playerId], references: [id])
  joinedAt DateTime @default(now())

  @@index([guildId])
}

// Аукцион игрок-игроку — POE2-style trade, но без отдельного "сайта": предмет при выставлении
// удаляется из Inventory продавца и его данные копируются сюда (эскроу) — гарантирует, что
// выставленный предмет нельзя случайно надеть/скрафтить/использовать, пока он на аукционе.
// При покупке/отмене строка удаляется, а предмет пересоздаётся в Inventory покупателя/
// обратно продавца. Комиссия 10% при продаже — не откладывается никуда, чистый sink золота
// (экономика уже получила несколько новых источников голда за эту сессию — крафт-валюта,
// заточка, модификаторы данжей, Разлом — нужен противовес).
model MarketListing {
  id               String   @id @default(cuid())
  sellerId         String
  seller           Player   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  itemId           String
  name             String
  type             String
  rarity           String
  stats            String?
  icon             String?
  itemLevel        Int?
  affixTier        String?
  affixes          String?
  enhancementLevel Int      @default(0)
  quantity         Int      @default(1)
  price            Int
  createdAt        DateTime @default(now())

  @@index([sellerId])
}

// Аукционный дом — премиум-эксклюзивная альтернатива мгновенному Рынку выше (MarketListing):
// отложенные ставки вместо мгновенной покупки, лот закрывается по истечении времени, а не по
// клику покупателя (lib/auction-house.ts). Тот же эскроу-приём для предмета, что у MarketListing
// (снимок данных на строке, оригинал удалён из Inventory продавца, пока лот жив). Ставка ставит
// голд бидера на удержание СРАЗУ (decrement при бите), а не в момент завершения — предыдущий
// лидер получает голд обратно (increment), как только его перебивают; при закрытии лота уже
// удержанный голд просто становится выплатой продавцу (минус комиссия AUCTION_FEE_PERCENT), без
// повторного списания. Закрытие — ленивое (тот же паттерн, что resolveFortressCycleIfNeeded):
// каждый GET проверяет expiresAt и резолвит просроченные лоты перед ответом.
model Auction {
  id               String   @id @default(cuid())
  sellerId         String
  seller           Player   @relation("AuctionSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  itemId           String
  name             String
  type             String
  rarity           String
  stats            String?
  icon             String?
  itemLevel        Int?
  affixTier        String?
  affixes          String?
  enhancementLevel Int      @default(0)
  quantity         Int      @default(1)
  startingPrice    Int
  currentBid       Int?
  currentBidderId  String?
  currentBidder    Player?  @relation("AuctionBidder", fields: [currentBidderId], references: [id])
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([sellerId])
  @@index([currentBidderId])
  @@index([expiresAt])
}

// Мировой босс — единственная строка-синглтон (id всегда "current"), общая HP для ВСЕХ игроков
// разом. Атака лениво роллится в POST /api/worldboss/attack (lib/world-boss.ts) — при 0 HP тут
// же выдаёт награду всем участникам текущего incarnation пропорционально их урону и спавнит
// следующего (incarnation+1, maxHp немного выше). Игрок не получает урон в ответ — это разовый
// вклад в общую цель, а не полноценный бой (аналог "мировых боссов" в мобильных RPG).
model WorldBoss {
  id          String   @id
  incarnation Int      @default(1)
  name        String
  hp          Int
  maxHp       Int
  spawnedAt   DateTime @default(now())

  contributions WorldBossContribution[]
}

// Один удар одного игрока по текущему incarnation мирового босса — сумма по playerId даёт долю
// награды при убийстве. Строки за ПРОШЛЫЕ incarnation удаляются сразу после раздачи наград
// (см. lib/world-boss.ts) — это эфемерный игровой прогресс, не история для отображения.
model WorldBossContribution {
  id          String    @id @default(cuid())
  bossId      String
  boss        WorldBoss @relation(fields: [bossId], references: [id], onDelete: Cascade)
  incarnation Int
  playerId    String
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  damage      Int
  createdAt   DateTime  @default(now())

  @@index([bossId, incarnation])
  @@index([playerId])
}

// Хранилище (сундук) — отдельное от боевого Inventory место для коллекционирования, не
// занимает боевые слоты и не расходуется/не экипируется напрямую (сначала нужно "достать"
// обратно в Inventory через POST /api/stash/retrieve). Ограничено STASH_CAPACITY
// (lib/stash.ts) — не безлимитный склад, а осмысленный выбор, что стоит сохранить.
model StashItem {
  id               String  @id @default(cuid())
  playerId         String
  player           Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  itemId           String
  name             String
  type             String
  rarity           String
  stats            String?
  icon             String?
  itemLevel        Int?
  affixTier        String?
  affixes          String?
  enhancementLevel Int     @default(0)
  quantity         Int     @default(1)

  @@index([playerId])
}

// Общий кошелёк/сейф на АККАУНТ (не на слот персонажа) — расшаривается между слотами,
// сгруппированными Player.accountId (см. комментарий у Player.accountId). Сознательно НЕ
// Player{Feature}State по правилу CLAUDE.md: та схема — для премиум-фич ОДНОГО персонажа,
// здесь же ключ принципиально другой — accountId (общий владелец), а не playerId, потому что
// смысл фичи — быть видимой ОБОИМ слотам одновременно. Доступен только когда у игрока уже есть
// accountId, т.е. второй слот создан (см. api/account/create-character) — до этого делить
// нечего, и заводить пустой vault не имеет смысла (создаётся лениво, upsert при первом депозите).
model AccountVault {
  id          String   @id @default(cuid())
  accountId   String   @unique
  gold        Int      @default(0)
  crownShards Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       AccountVaultItem[]
}

// Предметный аналог StashItem, но привязан к AccountVault, а не к Player — те же поля
// намеренно продублированы (не переиспользуется StashItem напрямую), чтобы playerId оставался
// обязательным на StashItem и не пришлось делать его nullable ради шаринга одной модели между
// двумя разными владельцами (Player vs AccountVault).
model AccountVaultItem {
  id               String       @id @default(cuid())
  vaultId          String
  vault            AccountVault @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  itemId           String
  name             String
  type             String
  rarity           String
  stats            String?
  icon             String?
  itemLevel        Int?
  affixTier        String?
  affixes          String?
  enhancementLevel Int          @default(0)
  quantity         Int          @default(1)

  @@index([vaultId])
}

// Крепость — единственный синглтон-объект territory-control между ГИЛЬДИЯМИ (в отличие от
// WorldBoss, который общий для всех игроков разом, здесь соревнуются гильдии между собой).
// Недельный цикл (ISO-неделя, lib/fortress.ts currentWeekId) — гильдия с наибольшей суммой
// очков штурма за цикл коронуется контролирующей и её участники получают +10% золота с любого
// боя до конца следующего цикла (см. combat/action.ts). Если за цикл никто не штурмовал —
// контроль остаётся у прежнего владельца (некому оспорить).
model Fortress {
  id                 String  @id
  cycleId            String  // "YYYY-Www"
  controllingGuildId String?

  contributions FortressContribution[]
}

// Один штурм одного игрока в текущем цикле — сумма по guildId даёт итог для коронации в конце
// цикла. Строки за ПРОШЛЫЙ цикл удаляются сразу после коронации (см. lib/fortress.ts) — как и
// WorldBossContribution, это эфемерный прогресс, не история.
model FortressContribution {
  id         String   @id @default(cuid())
  fortressId String
  fortress   Fortress @relation(fields: [fortressId], references: [id], onDelete: Cascade)
  cycleId    String
  guildId    String
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  points     Int
  createdAt  DateTime @default(now())

  @@index([cycleId, guildId])
  @@index([playerId])
}

// Гильд-рейд-босс — еженедельная КООП-цель ОДНОЙ гильдии (в отличие от WorldBoss, общего для
// ВСЕХ игроков разом, и Fortress, соревнования гильдия-против-гильдии). Один синглтон на
// гильдию (guildId уникален), недельный цикл — тот же currentWeekId, что у Fortress (lib/
// fortress.ts). HP масштабируется от размера гильдии (lib/guild-raid-boss.ts maxHpForGuild) —
// гильдия из 30 бьётся с боссом пропорционально крепче, чем гильдия из 3. В отличие от
// WorldBoss босс НЕ респавнится сразу после убийства — недельный кулдаун, ждём следующего
// resolveGuildRaidBossIfNeeded на новой ISO-неделе. Атаковать (получать урон в счёт награды)
// может только премиум-игрок — полноценный лок доступа, а не просто бонус к попыткам, как у
// WorldBoss; при этом состояние босса видно ВСЕМ членам гильдии (кооп-контент, прятать прогресс
// от небустнутых тиммейтов было бы социально неудобно).
model GuildRaidBoss {
  id        String   @id @default(cuid())
  guildId   String   @unique
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  cycleId   String   // "YYYY-Www"
  hp        Int
  maxHp     Int
  spawnedAt DateTime @default(now())

  contributions GuildRaidContribution[]
}

// Один удар одного игрока по рейд-боссу его гильдии в текущем цикле — сумма по playerId даёт
// долю награды при убийстве (та же схема, что WorldBossContribution). Строки за ПРОШЛЫЙ цикл
// удаляются при роллове недели (lib/guild-raid-boss.ts) — эфемерный прогресс, не история.
model GuildRaidContribution {
  id        String        @id @default(cuid())
  bossId    String
  boss      GuildRaidBoss @relation(fields: [bossId], references: [id], onDelete: Cascade)
  cycleId   String
  playerId  String
  player    Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  damage    Int
  createdAt DateTime      @default(now())

  @@index([bossId, cycleId])
  @@index([playerId])
}

// Разблокированный узел гильдейского дерева построек (аудит 4.1, D2) — постоянные пассивные
// бонусы гильдии за совместную активность (в отличие от GuildRaidBoss/Fortress выше, которые
// дают эфемерный/циклический прогресс). Дерево статично в lib/guild-upgrades.ts, здесь только
// факт разблокировки — тот же паттерн, что PlayerAchievement/PlayerCodexEntry ниже, только на
// уровне гильдии, а не игрока. Разблокировка необратима — построек, которые можно "снести"
// обратно в золото, нет (не должно быть способа фармить туда-обратно ради обхода cost).
model GuildUpgrade {
  id         String   @id @default(cuid())
  guildId    String
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  upgradeId  String   // статичный id из lib/guild-upgrades.ts GUILD_UPGRADES
  unlockedAt DateTime @default(now())

  @@unique([guildId, upgradeId])
  @@index([guildId])
}

// Разблокированные ачивки — определения статичны в lib/achievements.ts, здесь только факт
// разблокировки конкретным игроком (проверяется лениво на GET /api/achievements).
model PlayerAchievement {
  id            String   @id @default(cuid())
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  achievementId String
  unlockedAt    DateTime @default(now())

  @@unique([playerId, achievementId])
  @@index([playerId])
}

// Разблокированные записи лор-кодекса — определения статичны в lib/codex.ts, здесь только
// факт разблокировки (проверяется лениво на GET /api/codex, тот же паттерн, что и ачивки).
model PlayerCodexEntry {
  id         String   @id @default(cuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  entryId    String
  unlockedAt DateTime @default(now())

  @@unique([playerId, entryId])
  @@index([playerId])
}

// Постоянно изученные рецепты тира 3 — изучаются один раз через POST /api/craft/learn,
// расходуя предмет-чертёж (см. ITEMS type: 'blueprint' в game-data.ts). recipeId — id из
// CRAFTING_RECIPES (game-data.ts), не строка из БД — рецепты статичны, как и всё остальное
// игровое содержимое.
model PlayerRecipe {
  id         String   @id @default(cuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  recipeId   String
  unlockedAt DateTime @default(now())

  @@unique([playerId, recipeId])
  @@index([playerId])
}

// Награды за топ-3 места сезонного лидерборда — раздаются лениво раз в месяц, см.
// lib/seasons.ts и GET /api/leaderboard. Один ряд = одна выданная награда одному игроку
// за конкретный сезон ("2026-07"), список за сезон — история для "🏆 Прошлый сезон" в UI.
model SeasonReward {
  id         String   @id @default(cuid())
  season     String
  rank       Int
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  rewardGold Int
  rewardXp   Int
  awardedAt  DateTime @default(now())

  @@unique([season, rank])
  @@index([season])
}

// Итог топ-3 сезона Арены (lib/pvp-season.ts, ~7 недель) — ЧИСТО информационная запись без
// золота/предметов/титулов (в отличие от SeasonReward выше): PvP-рейтинг после этого момента
// мягко сжимается к базе у ВСЕХ игроков, а не только у топ-3, так что "награда" здесь — навсегда
// зафиксированное место в истории лиги, не механическое преимущество.
model PvpSeasonReward {
  id          String   @id @default(cuid())
  season      String
  rank        Int
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  ratingAtEnd Int
  awardedAt   DateTime @default(now())

  @@unique([season, rank])
  @@index([season])
}

// Испытание недели (аудит #2, топ-10 #6) — единственный горизонтальный endgame-контент до этого
// момента: весь остальной PvE вертикален (пройти один раз и вверх по уровню), Fortress/
// GuildRaidBoss дают еженедельный ритм только гильдиям. Это solo, бесплатно, без гильдии —
// детерминированно выбранный по неделе босс (см. lib/social/weekly-challenge.ts), одна попытка
// на игрока за неделю, бой резолвится мгновенно за один запрос (тот же принцип упрощения, что у
// PvP-арены lib/combat/pvp.ts, не полноценный движок combat-engine+boss-mechanics — честный
// компромисс ради предсказуемого объёма работы).
model WeeklyChallengeResult {
  id                 String   @id @default(cuid())
  weekId             String   // тот же ISO-week формат, что currentWeekId() у Fortress
  playerId           String
  player             Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  enemyId            String   // какой босс выпал на эту неделю
  won                Boolean
  turnsTaken         Int
  hpPercentRemaining Int      // 0-100 — тай-брейк лидерборда среди победивших
  createdAt          DateTime @default(now())

  @@unique([weekId, playerId])
  @@index([weekId])
}

model Inventory {
  id         String  @id @default(cuid())
  playerId   String
  player     Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  itemId     String
  name       String
  type       String  // weapon, armor, accessory, consumable, material, quest
  rarity     String  // common, uncommon, rare, epic, legendary, artifact, mythic
  equipped   Boolean @default(false)
  slot       String? // weapon, head, chest, legs, feet, accessory1, accessory2
  stats      String? // JSON string with bonuses
  quantity   Int     @default(1)
  icon       String? // emoji or image path
  itemLevel  Int?    // уровень предмета в момент выпадения — определяет доступные тиры аффиксов
                      // (см. lib/item-affixes.ts). null у предметов, не проходивших через ролл
                      // (материалы, куплен в магазине, скрафчен, квестовая награда).
  affixTier  String? // normal | magic | rare | corrupted — независимая от `rarity` ось: сколько
                      // случайных аффиксов накатано на этот конкретный экземпляр снаряжения.
                      // `rarity` остаётся как есть — это базовая ценность шаблона предмета.
  affixes    String? // JSON RolledAffix[] — какие именно аффиксы накатаны, для отображения и
                      // для крафт-валют (lib/item-affixes.ts, POST /api/craft/currency).
  enhancementLevel Int @default(0) // "заточка" 0-10 — см. lib/item-enhancement.ts. Каждый
                      // успешный уровень прибавляет +1 к каждому числовому ключу в `stats`
                      // (уже включён в сумму `stats`, как и аффиксы).
  enchantRerolls Int @default(0) // сколько раз точечный реброс (api/craft/enchant) применяли
                      // к этому конкретному предмету — растущая цена (см. lib/item-affixes.ts
                      // enchantCostForReroll) не даёт бесконечно фармить идеальный ролл на
                      // одном экземпляре. Никогда не сбрасывается.

  @@index([playerId])
  @@index([itemId])
}

model CharacterCreation {
  id        String  @id @default(cuid())
  playerId  String  @unique
  player    Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  step      Int     @default(0) // 0=name, 1=race, 2=class, 3=confirm
  name      String?
  race      String?
  class     String?
}

model PlayerQuest {
  id          String   @id @default(cuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  questId     String
  type        String   // daily, kill, explore, craft
  title       String
  description String
  target      Int      // e.g. kill 5 goblins
  progress    Int      @default(0)
  completed   Boolean  @default(false)
  claimed     Boolean  @default(false)
  reward      String   // JSON: {xp, gold, items}
  createdAt   DateTime @default(now())

  @@index([playerId])
  @@index([completed])
}

// Расы, классы и способности — источник истины: docs/cursed_depths_master.pdf
// и docs/cursed_depths_abilities.pdf (v2 — баланс). 6 рас, 26 классов (по 4 на
// расу, кроме Людей — у них 6: по 3 на каждый Путь), ~180 способностей по 3
// стадиям эволюции на класс.
model Race {
  id            String  @id @default(cuid())
  name          String
  slug          String  @unique
  description   String
  icon          String
  lore          String  // связь расы со Столпом-богом (Библия мира)
  baseStrength  Int
  baseDexterity Int
  baseVitality  Int
  baseIntellect Int
  baseWillpower Int
  baseInstinct  Int

  classes       GameClass[]
  players       Player[]
}

model GameClass {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  icon        String
  raceId      String
  race        Race      @relation(fields: [raceId], references: [id], onDelete: Cascade)
  path        String    // ash (Путь Пепла) | blight (Путь Скверны)
  role        String    // tank, healer, dps, support, antibuff
  primaryStat String    // приоритетная характеристика (информационно)

  abilities   Ability[]
  players     Player[]

  @@index([raceId])
  @@index([path])
}

model Ability {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  icon        String
  classId     String
  class       GameClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  stage       Int       // 1, 2 или 3 — стадия эволюции класса
  stageName   String    // название тира на этой стадии (напр. "Страж Предела")
  type        String    // active | passive
  bossNote    String?   // как способность работает иначе против боссов

  @@index([classId])
  @@index([stage])
}

// Комната трофеев — чисто коллекционная премиум-эксклюзивная механика (lib/boss-trophies.ts):
// счётчик побед над каждым уникальным боссом + богатый лор, раскрывающийся после первой победы.
// Никакой денежной награды — запись ведётся ТОЛЬКО пока премиум активен (killCount растёт с
// каждой новой победой над этим боссом при активном премиуме); без премиума механика недоступна
// целиком, не только "лучше награда" — та же логика, что у Экспедиций/Доски контрактов.
model PlayerBossTrophy {
  id              String   @id @default(cuid())
  playerId        String
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  enemyId         String
  killCount       Int      @default(0)
  firstDefeatedAt DateTime @default(now())
  lastDefeatedAt  DateTime @default(now())
  pityCounter     Int      @default(0)

  @@unique([playerId, enemyId])
  @@index([playerId])
}

// Редко читаемые дневные лимиты пяти механик, вынесенные из Player (аудит 2, волна 2B, п.4) —
// раньше каждый GET /api/player тянул эти поля вместе со всем остальным hot-path состоянием,
// даже для игроков, ни разу не трогавших ни одну из этих фич. 1:1 с Player, тот же паттерн,
// что и у PlayerBossTrophy/PlayerRecipe выше. Все пять полей "Today"/"Date" — lazy-reset: счётчик
// имеет смысл только если Date совпадает с сегодняшним днём, иначе читается как 0/null (см.
// каждый роут, который их использует). Не премиум-фича с собственным жизненным циклом (правило
// "премиум = отдельная таблица" тут ни при чём) — просто редко читаемый хвост Player.
model PlayerDailyLimits {
  id       String @id @default(cuid())
  playerId String @unique
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  worldBossAttacksToday Int     @default(0)
  worldBossAttackDate   String?
  fortressAssaultsToday Int     @default(0)
  fortressAssaultDate   String?
  raidBossAttacksToday  Int     @default(0)
  raidBossAttackDate    String?
  fortuneSpinsToday     Int     @default(0)
  fortuneSpinDate       String?
  bountyEnemyId         String?
  bountyDate            String?
  bountyAttempted       Boolean @default(false)
}

// Боевой пропуск — премиум-эксклюзивная сезонная прогрессия (lib/battle-pass.ts), тот же
// месячный цикл, что currentSeasonId (lib/seasons.ts), но НЕ связан с SeasonReward (тот —
// разовая награда топ-3 лидерборда, этот — тиры для любого игрока, набравшего очков). Player.
// battlePassXp растёт только пока премиум активен, лениво сбрасывается в 0 при смене сезона.
// Здесь хранится только факт получения награды за конкретный тир конкретного сезона — сами тиры
// и их награды статичны в lib/battle-pass.ts (тот же паттерн, что PlayerAchievement/PlayerRecipe).
model PlayerBattlePassClaim {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  seasonId  String   // "YYYY-MM"
  tier      Int
  claimedAt DateTime @default(now())

  @@unique([playerId, seasonId, tier])
  @@index([playerId, seasonId])
}

// Отметки посещённых локаций — основа премиум-эксклюзивного быстрого перемещения (lib/fast-
// travel.ts, POST /api/travel/fast): телепорт напрямую в любую УЖЕ посещённую локацию, минуя
// граф connections, который ограничивает обычное бесплатное перемещение (POST /api/travel)
// только соседними локациями. Отмечается лениво при каждом успешном перемещении + стартовая
// локация при создании персонажа (api/player/create) — сами визиты не история, а просто факт
// "здесь уже бывал", поэтому upsert без дублей.
model VisitedLocation {
  id         String   @id @default(cuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  locationId String
  visitedAt  DateTime @default(now())

  @@unique([playerId, locationId])
  @@index([playerId])
}
